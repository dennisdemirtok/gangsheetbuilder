<!-- Gang Sheet Builder — Product Page Section -->
<div style="margin: 24px 0; font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;">

  <!-- Main CTA — Build your own -->
  <button
    id="gangsheet-launch-btn"
    type="button"
    style="
      width: 100%;
      padding: 16px 24px;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #fff;
      background: #dc2f3c;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 16px rgba(220, 47, 60, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    "
    onmouseover="this.style.transform='translateY(-1px)';this.style.background='#b8232f';this.style.boxShadow='0 6px 20px rgba(220,47,60,0.25)'"
    onmouseout="this.style.transform='';this.style.background='#dc2f3c';this.style.boxShadow='0 4px 16px rgba(220,47,60,0.15)'"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
    {{ block.settings.button_text }}
  </button>

  {% if block.settings.show_upload_link %}
  <!-- Secondary CTA — Upload ready sheet -->
  <div style="margin-top: 10px; padding: 14px 18px; background: #f2f4f6; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
    <div style="flex: 1;">
      <p style="margin: 0; font-weight: 600; font-size: 13px; color: #191c1e;">{{ block.settings.upload_heading }}</p>
      <p style="margin: 3px 0 0; font-size: 12px; color: #4f6071; line-height: 1.4;">{{ block.settings.upload_subtext }}</p>
    </div>
    <a href="#" id="gangsheet-upload-link" style="color: #dc2f3c; font-weight: 600; font-size: 13px; text-decoration: none; white-space: nowrap; display: flex; align-items: center; gap: 4px; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
      Ladda upp
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
    </a>
  </div>
  {% endif %}

  {%- comment -%}
    Prices for the editor and the upload flow.

    Rendered by Liquid on purpose: Shopify prices these variants for whoever
    is looking, so a B2B contact on a company catalog sees their negotiated
    rate here without the app knowing anything about catalogs. The app used
    to compute its own price from a config table, which meant the number on
    screen and the number charged at checkout came from two places that
    could — and did — disagree.

    `price_product` should point at the per-length product (for example
    "DTF Transfers By Size"); it falls back to the product the block sits on.
  {%- endcomment -%}
  {%- assign price_product = block.settings.price_product -%}
  {%- if price_product == blank -%}
    {%- assign price_product = all_products['dtf-transfers-by-size'] -%}
  {%- endif -%}
  {%- if price_product == blank or price_product.variants.size == 0 -%}
    {%- assign price_product = product -%}
  {%- endif -%}
  <script id="gangsheet-variant-data" type="application/json">
    {
      {% for variant in price_product.variants %}
        {%- assign meters = variant.title | split: " " | first | plus: 0 -%}
        "{{ variant.title | handle }}": {
          "id": {{ variant.id }},
          "price": "{{ variant.price | money_without_currency }}",
          "price_cents": {{ variant.price }},
          "available": {{ variant.available | json }},
          {% if meters > 0 %}"size_key": "58x{{ meters | times: 100 }}",{% endif %}
          "title": {{ variant.title | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  </script>

  <!-- Info badges -->
  <div style="margin-top: 12px; display: flex; gap: 6px; flex-wrap: wrap;">
    <span style="padding: 4px 10px; background: rgba(46,125,50,0.06); color: #2e7d32; font-size: 11px; font-weight: 500; border-radius: 20px; display: flex; align-items: center; gap: 4px;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
      300 DPI utskriftskvalitet
    </span>
    <span style="padding: 4px 10px; background: rgba(79,96,113,0.06); color: #4f6071; font-size: 11px; font-weight: 500; border-radius: 20px; display: flex; align-items: center; gap: 4px;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
      58 cm bredd
    </span>
    <span style="padding: 4px 10px; background: rgba(79,96,113,0.06); color: #4f6071; font-size: 11px; font-weight: 500; border-radius: 20px; display: flex; align-items: center; gap: 4px;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Premium DTF-film
    </span>
  </div>
</div>

<!-- Fullscreen overlay for EDITOR -->
<div
  id="gangsheet-overlay"
  style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; width: 100vw; height: 100vh; z-index: 2147483647; background: #f7f9fb; overflow: hidden;"
>
  <div
    id="gangsheet-editor-root"
    data-shop="{{ shop.permanent_domain }}"
    data-app-proxy-url="/apps/gangsheet"
    data-currency="{{ shop.currency }}"
    style="width: 100vw; height: 100vh; overflow: hidden;"
  >
    <div id="gangsheet-loading" style="display: flex; align-items: center; justify-content: center; height: 100vh; background: #f7f9fb;">
      <div style="text-align: center;">
        <div style="width: 44px; height: 44px; border: 3px solid #dc2f3c; border-top-color: transparent; border-radius: 50%; animation: gs-lspin 0.8s linear infinite; margin: 0 auto 16px;"></div>
        <p style="color: #4f6071; font-size: 15px; font-family: system-ui;">{{ block.settings.loading_text }}</p>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes gs-lspin { to { transform: rotate(360deg); } }
  #gangsheet-launch-btn {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif !important;
  }
  body.gangsheet-open { overflow: hidden !important; height: 100vh !important; height: 100dvh !important; }
  #gangsheet-overlay, #gangsheet-overlay * { box-sizing: border-box !important; }
  #gangsheet-overlay {
    position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
    width: 100vw !important; height: 100vh !important; max-width: none !important; max-height: none !important;
    margin: 0 !important; padding: 0 !important; transform: none !important; z-index: 2147483647 !important; background: #f7f9fb !important;
    overscroll-behavior: contain !important;
  }
  /* dvh keeps the bottom action bar above the mobile browser chrome —
     with plain vh the "Lägg i varukorg" button sits under the URL bar. */
  @supports (height: 100dvh) {
    #gangsheet-overlay { height: 100dvh !important; }
  }
  #gangsheet-editor-root {
    position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important;
    max-width: none !important; margin: 0 !important; padding: 0 !important;
    overflow: hidden !important;
  }
  @supports (height: 100dvh) {
    #gangsheet-editor-root { height: 100dvh !important; }
  }
  /* The theme's own styles must not leak sizing into the editor tree. */
  #gangsheet-editor-root img, #gangsheet-editor-root svg { max-width: none; }
  #gangsheet-editor-root button { font: inherit; }
</style>

<script>
(function() {
  /*
   * Loader only.
   *
   * The editor and the ready-sheet upload both live in editor.iife.js and
   * share their upload, pricing and cart code. This block used to carry a
   * second implementation of all three in plain JS, which is how a
   * hardcoded price survived here long after the builder was fixed.
   */
  var overlay = document.getElementById('gangsheet-overlay');
  var btn = document.getElementById('gangsheet-launch-btn');
  var uploadLink = document.getElementById('gangsheet-upload-link');
  var scriptLoaded = false;
  var loading = false;
  var pending = [];

  function withBundle(fn) {
    if (scriptLoaded) { fn(); return; }
    pending.push(fn);
    if (loading) return;
    loading = true;

    var script = document.createElement('script');
    script.src = "{{ 'editor.iife.js' | asset_url }}";
    script.onload = function() {
      scriptLoaded = true;
      loading = false;
      var queued = pending.slice();
      pending = [];
      queued.forEach(function(f) { f(); });
    };
    script.onerror = function() {
      loading = false;
      pending = [];
      alert('Kunde inte ladda designverktyget. Ladda om sidan och försök igen.');
    };
    document.head.appendChild(script);
  }

  function openEditor() {
    overlay.style.display = 'block';
    document.body.classList.add('gangsheet-open');
    withBundle(function() {
      if (window.__gangsheetMount) window.__gangsheetMount();
    });
  }

  function closeEditor() {
    if (window.__gangsheetCloseEditor) window.__gangsheetCloseEditor();
    overlay.style.display = 'none';
    document.body.classList.remove('gangsheet-open');
    document.body.style.overflow = '';
  }

  if (btn) btn.addEventListener('click', openEditor);

  if (uploadLink) {
    uploadLink.addEventListener('click', function(e) {
      e.preventDefault();
      withBundle(function() {
        if (window.__gangsheetOpenUpload) window.__gangsheetOpenUpload();
      });
    });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.style.display === 'block') closeEditor();
  });
})();
</script>

{% schema %}
{
  "name": "Gang Sheet Builder",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Knapptext",
      "default": "BYGG DITT EGET GANG SHEET"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Laddningstext",
      "default": "Laddar Gang Sheet Builder..."
    },
    {
      "type": "checkbox",
      "id": "show_upload_link",
      "label": "Visa uppladdningslänk",
      "default": true
    },
    {
      "type": "text",
      "id": "upload_heading",
      "label": "Uppladdningsrubrik",
      "default": "Har du redan ett färdigt gang sheet?"
    },
    {
      "type": "text",
      "id": "upload_subtext",
      "label": "Uppladdningstext",
      "default": "Ladda enkelt upp ditt färdiga ark med några klick!"
    },
    {
      "type": "product",
      "id": "price_product",
      "label": "Prisprodukt (per längd)",
      "info": "Produkten vars varianter styr pris och varukorg, t.ex. \"DTF Transfers By Size\". Varje variant ska heta \"1 meter\", \"2 meter\" osv. Lämnas den tom används produkten som blocket ligger på."
    }
  ]
}
{% endschema %}
