{%- comment -%}
  Lagpaket: shirts, club logo, digits 0-9 and sponsor logos in one order.
  The shirt is the block's product setting; the stock digits ("Arena
  20 cm" / "Vit" / "7"), the logo prices ("Logga 8 cm" …) and the
  recommended press are given by handle, since an app block may have only
  one product setting. All are rendered
  here so Shopify prices them for whoever is looking.
  Clubs are metaobjects of type "forening" (namn, ort, idrott, logga,
  logga_bredd_cm, visa_i_listan). Only partner clubs, marked visa_i_listan
  after a signed agreement, are listed. Any other club is reached through
  a page of its own whose metafield custom.forening points at it
  (/pages/lag-<club>, template "lag"): that page offers its club and no
  list. A club's logo is never shown to everyone without its OK.
{%- endcomment -%}
{%- assign team_linked = nil -%}
{%- if page and page.metafields.custom.forening.value -%}
  {%- assign team_linked = page.metafields.custom.forening.value -%}
{%- endif -%}
{%- assign team_shirt = block.settings.shirt_product -%}
{%- assign team_prices = nil -%}
{%- if block.settings.price_handle != blank -%}
  {%- assign team_prices = all_products[block.settings.price_handle] -%}
{%- endif -%}
{%- assign team_digits = nil -%}
{%- if block.settings.digits_handle != blank -%}
  {%- assign team_digits = all_products[block.settings.digits_handle] -%}
{%- endif -%}
{%- assign team_press = nil -%}
{%- if block.settings.press_handle != blank -%}
  {%- assign team_press = all_products[block.settings.press_handle] -%}
{%- endif -%}
{%- comment -%} Anchor for the page's "Bygg ert lagpaket" button, clear of the sticky header. {%- endcomment -%}
<span id="lagpaket" style="display: block; position: relative; top: -96px; visibility: hidden;"></span>
<div
  id="gs-team-{{ block.id }}"
  class="gs-team-root"
  data-app-proxy-url="/apps/gangsheet"
  style="min-height: 620px; width: 100%;"
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-team>
    {
      "shirt": {%- if team_shirt -%}{
        "title": {{ team_shirt.title | json }},
        "vendor": {{ team_shirt.vendor | json }},
        "url": {{ team_shirt.url | json }},
        "variants": [
          {%- for variant in team_shirt.variants -%}
            {%- comment -%} The back packshot is the image whose alt names the colour and "baksida". {%- endcomment -%}
            {%- assign team_color = variant.option1 | downcase -%}
            {%- assign team_back = nil -%}
            {%- for img in team_shirt.images -%}
              {%- assign team_alt = img.alt | downcase -%}
              {%- if team_alt contains team_color and team_alt contains 'baksida' -%}
                {%- assign team_back = img -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {"id": {{ variant.id }}, "color": {{ variant.option1 | json }}, "size": {{ variant.option2 | json }}, "price_cents": {{ variant.price }}, "available": {{ variant.available | json }}, "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 300 | json }}{% else %}null{% endif %}, "front": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 900 | json }}{% else %}null{% endif %}, "back": {% if team_back %}{{ team_back | image_url: width: 900 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }{%- else -%}null{%- endif -%},
      "prices": [
        {%- if team_prices and team_prices.id -%}
          {%- for variant in team_prices.variants -%}
            {"id": {{ variant.id }}, "title": {{ variant.title | json }}, "price_cents": {{ variant.price }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ],
      "digits": [
        {%- if team_digits and team_digits.id -%}
          {%- for variant in team_digits.variants -%}
            {"id": {{ variant.id }}, "style": {{ variant.option1 | json }}, "color": {{ variant.option2 | json }}, "digit": {{ variant.option3 | json }}, "price_cents": {{ variant.price }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ],
      "press": {%- if team_press and team_press.id -%}{
        "variantId": {{ team_press.selected_or_first_available_variant.id }},
        "title": {{ team_press.title | json }},
        "vendor": {{ team_press.vendor | json }},
        "price_cents": {{ team_press.selected_or_first_available_variant.price }},
        "image": {% if team_press.featured_image %}{{ team_press.featured_image | image_url: width: 300 | json }}{% else %}null{% endif %},
        "url": {{ team_press.url | json }}
      }{%- else -%}null{%- endif -%},
      "linkedClub": {% if team_linked %}{{ team_linked.system.handle | json }}{% else %}null{% endif %},
      "partnerUrl": {{ block.settings.partner_url | default: '/pages/partnerforening' | json }},
      "clubs": [
        {%- assign team_sep = '' -%}
        {%- for club in shop.metaobjects.forening.values -%}
          {%- if team_linked -%}
            {%- unless club.system.handle == team_linked.system.handle -%}{%- continue -%}{%- endunless -%}
          {%- else -%}
            {%- unless club.visa_i_listan.value == true -%}{%- continue -%}{%- endunless -%}
          {%- endif -%}
          {{ team_sep }}{"id": {{ club.system.handle | json }}, "name": {{ club.namn.value | json }}, "city": {{ club.ort.value | json }}, "sport": {{ club.idrott.value | json }}, "logo": {% if club.logga.value %}{{ club.logga.value | image_url: width: 2400 | json }}{% else %}null{% endif %}, "widthCm": {{ club.logga_bredd_cm.value | default: 6 | json }}}
          {%- assign team_sep = ',' -%}
        {%- endfor -%}
      ]
    }
  </script>
  <div style="display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 320px; color: #6b6b70; font-size: 14px;">
    <span style="width: 18px; height: 18px; border-radius: 50%; border: 2px solid #dc2f3c; border-top-color: transparent; display: inline-block; animation: gs-team-load 0.8s linear infinite;"></span>
    Laddar…
  </div>
</div>

<style>
  @keyframes gs-team-load { to { transform: rotate(360deg); } }
  .gs-team-root svg { max-width: none; }
  .gs-team-root button, .gs-team-root input, .gs-team-root select { font: inherit; }
</style>

<script>
  (function () {
    var el = document.getElementById('gs-team-{{ block.id }}');
    function mount() {
      if (window.__gangsheetMountTeam) window.__gangsheetMountTeam(el);
    }
    if (window.__gangsheetMountTeam) return mount();
    var existing = document.querySelector('script[data-gs-bundle]');
    if (existing) return existing.addEventListener('load', mount);
    var s = document.createElement('script');
    s.src = "{{ 'editor.iife.js' | asset_url }}";
    s.async = true;
    s.setAttribute('data-gs-bundle', '1');
    s.onload = mount;
    s.onerror = function () {
      el.innerHTML = '<p style="padding:24px;text-align:center;color:#9a3412;">Kunde inte ladda. Ladda om sidan och försök igen.</p>';
    };
    document.head.appendChild(s);
  })();
</script>

{% schema %}
{
  "name": "Lagpaket",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "shirt_product",
      "label": "Tröja",
      "info": "Varianterna ska ha färg som första alternativ och storlek som andra."
    },
    {
      "type": "text",
      "id": "digits_handle",
      "label": "Siffror i lager (handtag)",
      "default": "lagsiffror",
      "info": "Tre alternativ: stil och höjd (\"Arena 20 cm\"), färg (\"Vit\", \"Svart\") och siffra (0-9)."
    },
    {
      "type": "text",
      "id": "price_handle",
      "label": "Priser för loggor (handtag)",
      "default": "lagpaket-tryck",
      "info": "Varianterna ska heta \"Logga 8 cm\", \"Logga 15 cm\" och \"Logga 25 cm\"."
    },
    {
      "type": "url",
      "id": "partner_url",
      "label": "Sida om partnerföreningar",
      "info": "Länkas från föreningssteget. Lämna tomt för /pages/partnerforening."
    },
    {
      "type": "text",
      "id": "press_handle",
      "label": "Rekommenderad press (handtag)",
      "default": "htvront-auto-heat-press-2",
      "info": "Visas som tillval för föreningar som pressar själva. Lämna tomt för att dölja."
    }
  ]
}
{% endschema %}
